# hail-mary-pipeline.service
#
# Jetson Orin Nano에서 Hail-Mary 엣지 파이프라인(capture -> detect -> M2 aggregate -> M3 buffer/uplink)을
# systemd로 관리하기 위한 유닛 파일. 기능명세서 M1~M3 비기능 요구사항 "가용성: Jetson 재부팅/네트워크
# 단절 후 자동 복구(M3 재전송) — systemd 재시작 정책 포함" 항목을 충족한다.
#
# 네트워크 단절 재전송 자체는 Hail_Mary/edge/buffer.py(로컬 SQLite 버퍼) + uplink.py(재시도)가
# 코드 레벨에서 이미 처리한다. 이 유닛은 그 위에서 "재부팅/프로세스 크래시 시 파이프라인 자체를
# 자동으로 다시 띄우는" 역할만 담당한다.
#
# 아래 User/WorkingDirectory/Environment 값은 실제 Jetson 배포 환경(사용자 계정, 리포 설치 경로,
# venv 경로 등)에 맞춰 현장에서 조정해야 하는 placeholder이다.

[Unit]
Description=Hail-Mary edge pipeline (capture -> detect -> M2 -> M3 buffer/uplink)
# 네트워크가 아직 안 올라온 상태에서 먼저 떠도 uplink.py의 재시도 로직이 흡수하므로
# network-online.target을 하드 Requires로 걸지 않고 순서만 뒤로 미룬다(After).
After=network-online.target
Wants=network-online.target
# 짧은 시간에 반복 크래시하면(예: 카메라 미연결) 무한 재시작 루프로 시스템 부하를 주지 않도록 제한.
# (StartLimitIntervalSec/StartLimitBurst는 systemd.unit(5) 규칙상 [Unit] 섹션에 위치해야 함)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# TODO(Jetson 현장 세팅): 실제 배포 계정/경로로 교체
User=orin
Group=orin
WorkingDirectory=/home/orin/Jetson

# PYTHONPATH: `python -m Hail_Mary.edge.pipeline`을 리포 루트에서 모듈로 실행하기 위함.
# venv를 쓸 경우 ExecStart의 python 경로도 venv 내부 python으로 바꿀 것(placeholder: 시스템 python3).
Environment=PYTHONPATH=/home/orin/Jetson
Environment=PYTHONUNBUFFERED=1

# TODO(Jetson 현장 세팅): --source/--zone-file/--endpoint 등 실제 카메라·존·서버 값으로 조정 필요.
# 아래 예시는 CSI 카메라 + GStreamer 백엔드 + calibrate.py로 만든 zone 파일을 쓰는 전형적인 배포 형태.
ExecStart=/usr/bin/python3 -m Hail_Mary.edge.pipeline \
    --backend gstreamer \
    --pipeline jetson_csi \
    --zone-file /home/orin/Jetson/Hail_Mary/edge/zones/hall_main.json \
    --endpoint http://127.0.0.1:8000/api/v1/occupancy \
    --db-path /home/orin/Jetson/Hail_Mary/edge/occupancy.db

# 재시작 정책: on-failure를 선택함(always가 아님).
# 이유: 운영자가 `systemctl stop`으로 의도적으로 내렸을 때는 재시작하지 않는 편이 안전(예: 카메라 점검,
# 유지보수). 크래시/비정상 종료(0이 아닌 종료 코드, 시그널)에는 재시작해서 재부팅/일시 장애에서
# 자동 복구되도록 한다. 재부팅 후 자동 기동은 [Install] WantedBy가 담당한다.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
